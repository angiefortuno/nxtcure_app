/* ───────── Helper Components ───────── */

const TimelineItem = ({ icon, title, subtitle, first, last }) => (
  <View style={styles.timelineItem}>
    <View style={styles.timelineLeft}>
      {!first && <View style={styles.line} />}
      <View style={styles.bullet}>{icon}</View>
      {!last && <View style={styles.line} />}
    </View>
    <View style={styles.timelineContent}>
      <Text style={styles.timelineTitle}>{title}</Text>
      <Text style={styles.timelineSubtitle}>{subtitle}</Text>
    </View>
  </View>
);

const StatCard = ({ label, value, full }) => (
  <View style={[styles.statCard, full && { marginRight: 0, flex: 1 }]}>
    <Text style={styles.statLabel}>{label}</Text>
    <Text style={styles.statValue}>{value}</Text>
  </View>
);

const Badge = ({ label, icon }) => (
  <View style={styles.badge}>
    <FontAwesome5 name={icon} size={14} style={{ marginRight: 6 }} />
    <Text style={styles.badgeText}>{label}</Text>
  </View>
);

