        {/* Medical Summary */}
        <Text style={styles.sectionTitle}>Medical Summary</Text>
        <View style={styles.summary}>
          <Text style={styles.summaryKey}>{diagnosis}</Text>
          <Text style={styles.summaryValue}>
            Treatment: {treatment}
          </Text>
        </View>

        {/* Achievements */}
        <Text style={styles.sectionTitle}>Achievements</Text>
        <View style={styles.achievements}>
          <Badge label="Community Supporter" icon="users" />
          <Badge label="Trial Participant" icon="vial" />
        </View>

        {/* Privacy */}
        <Text style={styles.sectionTitle}>Privacy</Text>
        <View style={styles.privacyRow}>
          <Text style={styles.privacyLabel}>Share Profile</Text>
          <Switch value={share} onValueChange={setShare} />
        </View>

        <View style={{ height: 80 }} />
      </ScrollView>
    </View>
  );
