            subtitle={diagnosis}
            first
          />
          <TimelineItem
            icon={<MaterialIcons name="medical-services" size={18} />}
            title="Treatment Start"
            subtitle={treatment}
          />
          <TimelineItem
            icon={<AntDesign name="checkcircle" size={18} />}
            title="Remission"
            subtitle={remissionStatus}
            last
          />
        </View>

        {/* Quick Stats */}
        <Text style={styles.sectionTitle}>Quick Stats</Text>
        <View style={styles.cardRow}>
          <StatCard label="Days Since Diagnosis" value={daysSince} />
          <StatCard label="Trials Applied" value={TrialsApplied} />
